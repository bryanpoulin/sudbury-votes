rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTopic(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.totalVotes is number && data.totalVotes >= 0 &&
             data.votesA is number && data.votesA >= 0 &&
             data.votesB is number && data.votesB >= 0 &&
             data.votesC is number && data.votesC >= 0 &&
             data.votesD is number && data.votesD >= 0 &&
             data.keys().hasAll(['id', 'totalVotes', 'votesA', 'votesB', 'votesC', 'votesD']) &&
             data.keys().size() <= 7;
    }

    function isValidBallot(data) {
      return data.topicId is string && data.topicId.size() <= 64 &&
             data.choice is string && data.choice.size() <= 8 &&
             data.voterToken is string && data.voterToken.size() <= 128 &&
             data.ward is string && data.ward.size() <= 32 &&
             data.votedAt is string && data.votedAt.size() <= 64 &&
             data.keys().hasAll(['topicId', 'choice', 'voterToken', 'ward', 'votedAt']) &&
             data.keys().size() == 5;
    }

    function isValidCivicIdea(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
             data.description is string && data.description.size() >= 5 && data.description.size() <= 600 &&
             data.ward is string && data.ward.size() <= 32 &&
             data.theme is string && data.theme.size() <= 32 &&
             data.secondsCount is number && data.secondsCount >= 0 &&
             data.authorToken is string && data.authorToken.size() <= 128 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.status is string && (data.status == 'active' || data.status == 'flagged' || data.status == 'hidden') &&
             data.keys().hasAll(['id', 'title', 'description', 'ward', 'theme', 'secondsCount', 'authorToken', 'createdAt', 'status']) &&
             data.keys().size() <= 10;
    }

    function isValidCivicIdeaUpdate(inc, ext) {
      return inc.id == ext.id &&
             inc.authorToken == ext.authorToken &&
             inc.createdAt == ext.createdAt &&
             inc.secondsCount is number && inc.secondsCount >= 0 &&
             (inc.status == 'active' || inc.status == 'flagged' || inc.status == 'hidden') &&
             isValidCivicIdea(inc);
    }

    function isValidCivicIdeaSecond(data) {
      return data.ideaId is string && data.ideaId.size() <= 64 &&
             data.voterToken is string && data.voterToken.size() <= 128 &&
             data.secondedAt is string && data.secondedAt.size() <= 64 &&
             data.keys().hasAll(['ideaId', 'voterToken', 'secondedAt']) &&
             data.keys().size() == 3;
    }

    // Public civic sentiment topic tallies
    match /sentiment_topics/{topicId} {
      allow read: if isValidId(topicId);
      allow create, update: if isValidId(topicId) && isValidTopic(incoming());
      allow delete: if false;
    }

    // Voter ballots: allow create and update for the duration of the active poll
    match /voter_ballots/{ballotId} {
      // Allow single get check for voter token validation; block list enumeration
      allow get: if isValidId(ballotId);
      allow list: if false;
      // Allow creation of ballot
      allow create: if isValidId(ballotId) && isValidBallot(incoming());
      // Allow updating existing ballot choice by voter
      allow update: if isValidId(ballotId) && isValidBallot(incoming());
      allow delete: if false;
    }

    // Public crowdsourced civic priority proposals submitted by Sudbury residents
    match /civic_ideas/{ideaId} {
      allow read: if isValidId(ideaId);
      allow list: if true;
      allow create: if isValidId(ideaId) && isValidCivicIdea(incoming());
      allow update: if isValidId(ideaId) && isValidCivicIdeaUpdate(incoming(), existing());
      allow delete: if false;
    }

    // Registry of citizen support seconds keyed by ideaId_voterToken
    match /civic_idea_seconds/{secondId} {
      allow get: if isValidId(secondId);
      allow list: if false;
      allow create: if isValidId(secondId) && isValidCivicIdeaSecond(incoming());
      allow delete: if isValidId(secondId);
    }
  }
}
